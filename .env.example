# Copy to .env for local development. Never commit .env.

# Telegram bot (from @BotFather)
API_TOKEN=
BOT_USERNAME=

# Public HTTPS base URL of the app (ngrok for local development)
WEBAPP_URL=https://your-tunnel.ngrok-free.app

# Database. Any SQLAlchemy URL; postgres:// is accepted and rewritten.
# Quick start without PostgreSQL:
DATABASE_URL=sqlite:///affinia_dev.db
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/affinia

# Optional
# LOG_SALT=                 # salt for pseudonymous user tags in logs
# INIT_DATA_MAX_AGE=86400   # seconds
# PROXY_HOPS=0              # trusted reverse-proxy hops (1 on Heroku, auto-detected)
# TGA_TOKEN=                # Telegram Apps Center analytics (both must be set to embed the SDK)
# TGA_APP_NAME=
# PRIVACY_CONTACT=kuilya9649@gmail.com  # email shown on /privacy and /terms
