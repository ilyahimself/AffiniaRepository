# .env.example
# Пример файла с переменными окружения для локальной разработки
# Скопируйте этот файл в .env и заполните своими значениями

# PostgreSQL Database URL (скопируйте из Heroku Config Vars)
HEROKU_POSTGRESQL_COBALT_URL=your_postgresql_url_here

# Или используйте DATABASE_URL
# DATABASE_URL=postgresql://user:password@localhost/affinia

# Для локального тестирования миграции можно использовать локальный PostgreSQL:
# DATABASE_URL=postgresql://localhost/affinia_test
